# ─────────────────────────────────────────────────────────────────────────────
# Kesavan's DJ Booth — music provider config (ALL OPTIONAL).
#
# The player works with ZERO configuration: it calls the public iTunes Search
# API directly from the browser (CORS-enabled, no API key, no account, no server,
# no proxy). These vars only exist so the public endpoint / storefront can be
# swapped without code changes. NEVER put secrets or API keys here.
# ─────────────────────────────────────────────────────────────────────────────

# Search endpoint. Default: Apple's public iTunes Search API.
# (Must return the iTunes Search JSON shape; see src/music/providers/itunesProvider.ts)
VITE_MUSIC_API_URL=https://itunes.apple.com/search

# Storefront country for catalogue/coverage. "IN" gives the best Tamil/Indian
# coverage. Any 2-letter iTunes storefront code works (e.g. US, GB, IN).
VITE_MUSIC_COUNTRY=IN

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL full-length audio (OFF by default — leave this UNSET).
#
# When unset, the player uses iTunes 30-second previews only (the default,
# verified experience). When set to a Piped-compatible API base URL, the player
# will additionally try to resolve the SAME track to a FULL stream and label it
# "Full song", automatically falling back to the iTunes preview if that fails.
#
# HONEST CAVEAT (tested 2026): there is currently NO keyless, CORS-enabled,
# browser-direct endpoint that reliably returns full commercial (incl. Tamil)
# audio — YouTube's InnerTube API is CORS-blocked in browsers, and public Piped
# instances are blocked by YouTube's "confirm you're not a bot" check on their
# server IPs. This hook exists so full songs light up automatically IF a working
# Piped-compatible endpoint ever becomes available to you. It intentionally adds
# NO server/proxy of its own. Example (only if you have a working instance):
# VITE_FULLSONG_API_URL=https://pipedapi.example.com
